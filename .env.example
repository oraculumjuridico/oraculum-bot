# Runtime
NODE_ENV=production
PORT=10000
PUBLIC_BASE_URL=
APP_URL=

# Meta / WhatsApp
VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
APP_SECRET=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
INTERNAL_WEBHOOK_SECRET=
AUDIO_URL_SECRET=
AUDIO_URL_TTL_SECONDS=900
WHATSAPP_ADMIN=
WHATSAPP_TEMPLATE_TERCEIRO=
WHATSAPP_TEMPLATE_LANG=pt_BR
WHATSAPP_TEMPLATE_TERCEIRO_IMAGEM_URL=

# Lightning / Supertonic TTS
# O corpo de POST /tts permanece somente {"text":"..."}; a voz segue no header X-Oraculum-Voice.
LIGHTNING_TTS_URL=
LIGHTNING_TTS_TOKEN=
LIGHTNING_TTS_TIMEOUT_MS=60000

# HubSpot
HUBSPOT_TOKEN=
HUBSPOT_PORTAL=

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_OAUTH_LOCAL_PORT=3333
DRIVE_PASTA_CLIENTES_ID=
GOOGLE_MAPS_API_KEY=

# AI and transcription
ASSEMBLYAI_KEY=
GROQ_KEY=
GROQ_DOCUMENT_MODEL=llama-3.1-8b-instant
GROQ_DOCUMENT_TIMEOUT_MS=4000

# Document scanner (local OpenCV/WASM; original files are always preserved)
DOCUMENT_SCANNER_ENABLED=true

# Email
GMAIL_USER=
GMAIL_PASS=

# Administration
ADMIN_WHATSAPP_PASSWORD=
ADMIN_WHATSAPP_PASSWORD_HASH=
# O cofre interno usa a mesma senha administrativa como senha mestre e o Neon
# já configurado. Não registre senhas de clientes neste arquivo.

# Runtime behavior
AUTO_REENGAJAMENTO=false
INTERNAL_SCHEDULER_ENABLED=false
INTERNAL_SCHEDULER_INTERVAL_MS=300000
INTERNAL_SCHEDULER_BATCH_SIZE=25
INTERNAL_SCHEDULER_GITHUB_REPOSITORY=oraculumjuridico/oraculum-bot
CONSULTA_LEMBRETE_HOJE_HORA=9
# Fail-closed: sem um alvo de piloto, o agendador não executa jobs.
AUTOMATION_ALLOW_ALL=false
AUTOMATION_PILOT_CASES=
AUTOMATION_PILOT_DEAL_IDS=
AUTOMATION_PILOT_PHONES=
REENGAGEMENT_CANCEL_WEBHOOK_URL=
REENGAGEMENT_CANCEL_WEBHOOK_TIMEOUT_MS=1500
DEBUG_LOGS=false
AXIOS_TIMEOUT_MS=15000
FFMPEG_TIMEOUT_MS=60000
WHATSAPP_MEDIA_MAX_BYTES=20971520
CALLBACK_IDEMPOTENCY_PROCESSING_TTL_MS=900000

# Consultation enforcement
CONSULTA_ARCHITECTURE_AUDIT_MODE=strict
CONSULTA_ENFORCEMENT_MODE=
CONSULTA_RUNTIME_ENFORCEMENT_MODE=
CONSULTATION_FIREWALL_MODE=
CONSULTA_EVENTS_FILE=
CONSULTA_DECISIONS_FILE=
CONSULTA_INTEGRITY_EVENTS_FILE=
CONSULTATION_DEAL_ID=

# Optional image assets
IMAGEM_BOAS_VINDAS_URL=
IMAGEM_MENU_CLIENTE_URL=
IMAGEM_GUIA_DOCS_URL=
IMAGEM_CONFIRMACAO_URL=
IMAGEM_CASO_REGISTRADO_URL=
IMAGEM_NOVO_CASO_URL=
IMAGEM_ASSESSORIA_INICIAL_URL=
IMAGEM_RELATO_URL=
IMAGEM_POS_RELATO_URL=
IMAGEM_SELECAO_CASO_URL=
IMAGEM_ADV_URL=
IMAGEM_ADV_HORARIOS_URL=
IMAGEM_ADV_URGENTE_URL=
IMAGEM_ADV_AGENDADO_URL=
IMAGEM_ADV_URGENTE_REGISTRADA_URL=
IMAGEM_STATUS_URL=
IMAGEM_DOC_AVULSO_URL=
IMAGEM_DOC_ANEXADO_URL=
IMAGEM_DOC_RECEBIDO_URL=
IMAGEM_DOCS_PENDENTES_URL=
IMAGEM_DOCS_FINAL_URL=
IMAGEM_ENVIO_EXTRA_URL=
ORACULUM_DATA_DIR=/tmp/oraculum
EXTERNAL_STATE_PROVIDER=neon
EXTERNAL_STATE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
EXTERNAL_STATE_SSL=true
EXTERNAL_STATE_REQUIRED=true
EXTERNAL_STATE_ALLOW_EPHEMERAL_FALLBACK=false
EXTERNAL_STATE_POOL_MAX=2
EXTERNAL_STATE_CONNECT_TIMEOUT_MS=10000

# Post-Human Complementation
POST_HUMAN_COMPLEMENTATION_ENABLED=false
POST_HUMAN_PILOT_CASES=
# Alias legado temporário; POST_HUMAN_PILOT_CASES tem prioridade.
POST_HUMAN_COMPLEMENTATION_ALLOWLIST=
POST_HUMAN_ACTION_TTL_MS=1800000
POST_HUMAN_ACTION_MAX_CONTEXTS=1000
# Alias legado: WHATSAPP_TEMPLATE_CASO_ATUALIZACAO_IMAGEM_URL
POST_HUMAN_TEMPLATE_IMAGE_URL=
