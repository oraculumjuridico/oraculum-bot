{
  "name": "Oraculum - Consulta - disparo recorrente de lembretes",
  "blueprintVersion": "2026-07-08-production-blockers",
  "dataStore": "consulta_reminders",
  "states": ["pending", "sent", "skipped", "cancelled"],
  "schedule": {
    "type": "interval",
    "everyMinutes": 5
  },
  "metadata": {
    "purpose": "Buscar lembretes pendentes vencidos no Data Store e chamar /lembrete apenas no horario seguro.",
    "requiredConnections": ["HTTP Oraculum", "Data Store consulta_reminders"],
    "requiredVariables": ["ORACULUM_BASE_URL", "INTERNAL_WEBHOOK_SECRET"]
  },
  "flow": [
    {
      "id": 1,
      "module": "builtin:BasicTrigger",
      "version": 1,
      "parameters": {
        "interval": 300
      }
    },
    {
      "id": 2,
      "module": "datastore:searchRecords",
      "version": 1,
      "mapper": {
        "datastore": "consulta_reminders",
        "limit": 25,
        "filter": "status == pending AND parseDate(scheduledFor) <= now"
      }
    },
    {
      "id": 3,
      "module": "tools:Iterator",
      "version": 1,
      "mapper": {
        "array": "{{2.records}}"
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "mapper": {
        "method": "POST",
        "url": "{{ORACULUM_BASE_URL}}/lembrete",
        "headers": [
          {
            "name": "x-internal-secret",
            "value": "{{INTERNAL_WEBHOOK_SECRET}}"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\"phone\":\"{{3.phone}}\",\"name\":\"{{3.name}}\",\"eventId\":\"{{3.eventId}}\",\"dealId\":\"{{3.dealId}}\",\"casoId\":\"{{3.casoId}}\",\"datetime\":\"{{3.datetime}}\",\"tipo\":\"{{3.tipo}}\",\"scheduledFor\":\"{{3.scheduledFor}}\"}"
      },
      "errorHandlers": [
        {
          "name": "Network ou 5xx",
          "action": "leave-pending",
          "reason": "Retry natural do proximo ciclo; idempotencia do bot evita duplicidade."
        },
        {
          "name": "409 lembrete_antecipado",
          "action": "leave-pending",
          "reason": "O bot devolve scheduledFor corrigido quando aplicavel."
        },
        {
          "name": "404 usuario/evento nao encontrado",
          "action": "mark-skipped",
          "reason": "Nao enviar template sem contexto ativo."
        },
        {
          "name": "409 consulta_passada ou evento cancelado",
          "action": "mark-skipped",
          "reason": "Lembrete perdeu validade operacional."
        }
      ]
    },
    {
      "id": 5,
      "module": "datastore:updateRecord",
      "version": 1,
      "mapper": {
        "datastore": "consulta_reminders",
        "key": "{{3.key}}",
        "record": {
          "status": "sent",
          "sentAt": "{{now}}",
          "httpStatus": "{{4.statusCode}}",
          "lastAttemptAt": "{{now}}"
        }
      },
      "filter": {
        "name": "Sucesso HTTP",
        "conditions": ["4.statusCode >= 200", "4.statusCode < 300"]
      }
    },
    {
      "id": 6,
      "module": "datastore:updateRecord",
      "version": 1,
      "mapper": {
        "datastore": "consulta_reminders",
        "key": "{{3.key}}",
        "record": {
          "status": "skipped",
          "skippedAt": "{{now}}",
          "skipReason": "{{4.body.erro}}",
          "httpStatus": "{{4.statusCode}}",
          "lastAttemptAt": "{{now}}"
        }
      },
      "filter": {
        "name": "Falha terminal",
        "conditions": [
          "4.statusCode == 404 OR 4.body.erro in [consulta_passada, evento cancelado, usuario_nao_encontrado_para_contexto]"
        ]
      }
    }
  ]
}
